  "cards": [
    { "dot": "cyan", "title": "Order", "items": ["The config is loaded once, before any category runs", "Hooks run per category, before the scan and after it", "History is buffered in memory and written to disk once, at the end"] },
    { "dot": "emerald", "title": "Per file", "items": ["Filters combine name, age and size, nested with any / all / not", "The path comes from organize-by and rename tokens", "One of 8 conflict strategies decides a name collision, then move, copy or symlink runs"] },
    { "dot": "rose", "title": "Branches", "items": ["--dry-run plans without touching a file", "action: archive packs the whole category and is not undoable", "SIGINT stops before the next category and still writes history"] }

    { "id": "filters-destination", "from": "filters", "to": "destination", "label": "matched", "variant": "emphasis" },
    { "id": "destination-action", "from": "destination", "to": "action", "label": "resolved path", "variant": "emphasis" },
    { "id": "filters-archive", "from": "filters", "to": "archive", "label": "action: archive", "variant": "dashed", "role": "branch" },

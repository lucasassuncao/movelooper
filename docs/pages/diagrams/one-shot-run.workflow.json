      { "id": "archive-branch", "label": "Archive branch", "focus": ["filters", "archive"], "note": "action: archive packs the whole category instead of acting file by file." },
      { "id": "history", "label": "History", "focus": ["action", "history"], "note": "Entries are buffered in memory and written to disk once, at the end of the run." }

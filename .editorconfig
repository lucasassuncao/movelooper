root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{json,md,html,css}]
indent_style = space
indent_size = 2

[*.mod]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.sh]
indent_style = tab
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 4

[*.toml]
indent_style = space
indent_size = 2

[Dockerfile]
indent_style = space
indent_size = 4

[*.{png,gif,jpg,ico}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.tape]
trim_trailing_whitespace = false
